sc.true
// sfa_rx570.wh - SimpleFullAccess (SFA) GPGPU & Low-level Driver Interface for RX 570 (Polaris 20)
sect.sfa_const
    u32 PACKET_TYPE3 = 3;
    u32 PACKET3_NOP = 16;                 // 0x10 NOP-пакет
    u32 PACKET3_SET_SH_REG = 118;         // 0x76 Установка регистров шейдера
    u32 PACKET3_SET_SH_REG_START = 11264; // 0x2c00 Базовое смещение регистров
    u32 PACKET3_DISPATCH_DIRECT = 21;     // 0x15 Прямой запуск грида вычислений

    u32 mmCOMPUTE_PGM_LO = 11788;         // 0x2e0c Шейдерный программный счетчик (Low)
    u32 mmCOMPUTE_PGM_HI = 11789;         // 0x2e0d Шейдерный программный счетчик (High)
    u32 mmCOMPUTE_USER_DATA_0 = 11840;     // 0x2e40 Регистр аргументов ядра GPU (SGPR0)

    // PCI адреса по умолчанию для Bare-metal систем
    u64 BAREMETAL_MMIO_BASE = 0xFEA00000;
    u64 BAREMETAL_VRAM_BASE = 0xD0000000;
EOS

packed struct SfaDevice version 1 {
    u64 mmio_base version 1;
    u64 vram_base version 1;
    u64 gart_base version 1;
    u32 device_id version 1;
    u32 is_hosted version 1;
    u64 fd version 1;
}

packed struct SfaQueue version 1 {
    u64 ring_buffer_ptr version 1;
    u32 ring_size version 1;
    u32 rptr version 1;
    u32 wptr version 1;
    u64 doorbell_ptr version 1;
    u32 doorbell_offset version 1;
}

packed struct GpuKernel version 1 {
    u64 code_ptr version 1;
    u32 code_size version 1;
    u32 grid_dim_x version 1;
    u32 block_dim_x version 1;
}
