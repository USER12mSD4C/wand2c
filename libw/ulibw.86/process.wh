sc.true

struct ProcessInfo {
    i64 pid;
    i64 status;
    i64 exit_code;
}

extern fn process_fork() -> i64;
extern fn process_exec(u8* path, u8* argv, u8* envp) -> i64;
extern fn process_wait(i64 pid, ProcessInfo* info) -> i64;
extern fn process_exit(i64 code);
extern fn process_kill(i64 pid, u64 signum) -> i64;
extern fn process_get_pid() -> i64;
extern fn process_get_ppid() -> i64;
extern fn process_sleep_ms(u64 ms) -> u64;
extern fn process_yield() -> u64;
