sc.true

#import <syscall_constants>
#import <syscall_structs>

extern fn sys_read(u64 fd, u8* buf, u64 size) -> u64;
extern fn sys_write(u64 fd, u8* buf, u64 size) -> u64;
extern fn sys_open(u8* path, u64 flags, u64 mode) -> u64;
extern fn sys_close(u64 fd) -> u64;
extern fn sys_stat(u8* path, u8* statbuf) -> u64;
extern fn sys_fstat(u64 fd, u8* statbuf) -> u64;
extern fn sys_lstat(u8* path, u8* statbuf) -> u64;
extern fn sys_lseek(u64 fd, u64 offset, u64 whence) -> u64;
extern fn sys_ioctl(u64 fd, u64 request, u64 arg) -> u64;
extern fn sys_dup2(u64 oldfd, u64 newfd) -> u64;
extern fn sys_nanosleep(u8* req, u8* rem) -> u64;
extern fn sys_getpid() -> u64;
extern fn sys_fork() -> u64;
extern fn sys_execve(u8* path, u8* argv, u8* envp) -> u64;
extern fn sys_exit(u64 code);
extern fn sys_wait4(u64 pid, u64* status, u64 options, u8* rusage) -> u64;
extern fn sys_kill(u64 pid, u64 sig) -> u64;
extern fn sys_unlink(u8* path) -> u64;
extern fn sys_readlink(u8* path, u8* buf, u64 size) -> u64;
extern fn sys_chmod(u8* path, u64 mode) -> u64;
extern fn sys_chown(u8* path, u64 uid, u64 gid) -> u64;
extern fn sys_getuid() -> u64;
extern fn sys_syslog(u64 kind, u8* buf, u64 len) -> u64;
extern fn sys_getgid() -> u64;
extern fn sys_setuid(u64 uid) -> u64;
extern fn sys_setgid(u64 gid) -> u64;
extern fn sys_geteuid() -> u64;
extern fn sys_getegid() -> u64;
extern fn sys_setpgid(u64 pid, u64 pgid) -> u64;
extern fn sys_setsid() -> u64;
extern fn sys_getrlimit(u64 resource, u8* rlim) -> u64;
extern fn sys_setrlimit(u64 resource, u8* rlim) -> u64;
extern fn sys_mount(u8* source, u8* target, u8* fstype, u64 flags, u8* data) -> u64;
extern fn sys_umount2(u8* target, u64 flags) -> u64;
extern fn sys_reboot(u64 magic1, u64 magic2, u64 cmd, u8* arg) -> u64;
extern fn sys_prctl(u64 option, u64 a2, u64 a3, u64 a4, u64 a5) -> u64;
extern fn sys_getdents64(u64 fd, u8* dirp, u64 count) -> u64;
extern fn sys_clock_gettime(u64 clockid, u8* tp) -> u64;
extern fn sys_rt_sigaction(u64 signum, u8* act, u8* oldact, u64 sigsetsize) -> u64;
extern fn sys_rt_sigprocmask(u64 how, u8* set, u8* oldset, u64 sigsetsize) -> u64;
extern fn sys_unshare(u64 flags) -> u64;
extern fn sys_setns(u64 fd, u64 nstype) -> u64;
extern fn sys_exit_group(u64 code);
extern fn sys_socket(u64 domain, u64 type, u64 protocol) -> u64;
extern fn sys_connect(u64 sockfd, u8* addr, u64 addrlen) -> u64;
extern fn sys_accept(u64 sockfd, u8* addr, u64* addrlen) -> u64;
extern fn sys_sendto(u64 sockfd, u8* buf, u64 len, u64 flags, u8* dest_addr, u64 addrlen) -> u64;
extern fn sys_recvfrom(u64 sockfd, u8* buf, u64 len, u64 flags, u8* src_addr, u64* addrlen) -> u64;
extern fn sys_bind(u64 sockfd, u8* addr, u64 addrlen) -> u64;
extern fn sys_listen(u64 sockfd, u64 backlog) -> u64;
extern fn sys_epoll_create(u64 flags) -> u64;
extern fn sys_epoll_ctl(u64 epfd, u64 op, u64 fd, u8* event) -> u64;
extern fn sys_epoll_wait(u64 epfd, u8* events, u64 maxevents, u64 timeout) -> u64;
extern fn mloc(u64 hint, u64 size) -> u8*;
extern fn mfree(u8* ptr);
extern fn sys_mkdir(u8* path, u64 mode) -> u64;
extern fn sys_rmdir(u8* path) -> u64;
export fn syscall_error(u64 ret) -> u64;
fn sys_mmap(u64 addr, u64 length, u64 prot, u64 flags, u64 fd, u64 offset) -> u64;

struct Stat version 1 {
    u64 dev version 1;
    u64 ino version 1;
    u64 nlink version 1;
    u32 mode version 1;
    u32 uid version 1;
    u32 gid version 1;
    u32 pad0 version 1;
    u64 rdev version 1;
    u64 size version 1;
    u64 blksize version 1;
    u64 blocks version 1;
    u64 atime_sec version 1;
    u64 atime_nsec version 1;
    u64 mtime_sec version 1;
    u64 mtime_nsec version 1;
    u64 ctime_sec version 1;
    u64 ctime_nsec version 1;
}
